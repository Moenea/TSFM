    "# 单窗口对比:基线(4专家)+ 旧gate(exp A)+ 新gate(alarm,深蓝突出)。改 run/local 或 index。\n",
    "# 默认窗口 = money shot:真值向上越 UCL,旧 gate(exp A)死平在 ~0.21 完全漏报,新 gate 跟上越限。\n",
    "# (提示:单窗口里某个专家常局部最优;gate 的价值在跨窗口鲁棒 + 越限召回,见 gate3_metrics())\n",
    "# 想找更多\"真值会越限\"的报警相关窗口:先用 alarm_windows(run=9) 看 global_idx。\n",
    "plot_compare(run=9, local=1553);       # 另可试 local=1211/694(向上越限)/ local=1382/653(向下越 LCL)"
