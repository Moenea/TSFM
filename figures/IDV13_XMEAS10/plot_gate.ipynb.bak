  {
   "cell_type": "markdown",
   "id": "97776999",
   "metadata": {},
   "source": [
    "## 📈 Recall–FAR 帕累托图(诚实版:为什么新 gate 比 baseline + 旧 gate 好)\n",
    "单窗口看不出新 gate 的优势(它是专家的凸组合,永远不可能比\"当时最对的那个专家\"更准)。\n",
    "真正能证明\"新 gate 更好\"的是这张 **recall vs 误报率** 散点(Run9-10 clean 窗口,mag=25 限):\n",
    "- **新 gate 严格压制旧 gate exp A**(recall 更高 + 误报更低,见箭头);\n",
    "- **在 5% 误报预算内,新 gate 的 recall 最高且甩开一大截**(0.49 vs ≤0.24);\n",
    "- diff 的 recall 虽高(0.61)但误报 13% 超预算不可用;旧 gate 误报 6% 也超预算。\n",
    "\n",
    "> 数据来自 batch_metrics 汇总 `_expcompare`(已生成)。`plot_pareto(save=True)` 可存 png+pdf。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 112,
   "id": "9f62ef38",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 860x630 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "         model  recall   FAR\n",
      "          diff   0.614 0.128\n",
      "           raw   0.237 0.022\n",
      "      time_moe   0.211 0.004\n",
      "       sundial   0.228 0.001\n",
      " Gate-old-expA   0.430 0.062\n",
      "Gate-NEW-alarm   0.491 0.021\n"
     ]
    }
   ],
   "source": [
    "# === 📈 Recall–FAR 帕累托图:4 专家 + 旧 gate + 新 gate(Run9-10 clean 窗口,mag=25 限)===\n",
    "# 读 batch_metrics 汇总 _expcompare(已生成)。若结果重算需刷新,在 TSFM 根目录跑:\n",
    "#   python utils/batch_metrics.py --config setting/bm_expcompare.yaml \\\n",
    "#          --summary-suffix _expcompare --figure-suffix _expcompare\n",
    "def plot_pareto(summary_suffix=\"_expcompare\", save=False):\n",
    "    \"recall vs 误报率散点:一眼看谁在 5% 预算内 recall 最高。新 gate = 深蓝星。\"\n",
    "    f = RESULTS / f\"XMEAS10 Purge Rate_Summary{summary_suffix}\" / \"summary.csv\"\n",
    "    if not f.exists():\n",
    "        print(\"缺\", f, \"\\n先跑 batch_metrics(见本 cell 顶部注释)\"); return\n",
    "    d = pd.read_csv(f)\n",
    "    d[\"recall\"] = d.ratio_pred_in_true_alarm_patches_clean\n",
    "    d[\"FAR\"] = d.ratio_pred_in_no_true_alarm_patches_clean\n",
    "    STY = {\"diff\": (EXPERT_COLORS[\"diff\"], \"o\", \"Timer-XL diff\"),\n",
    "           \"raw\": (EXPERT_COLORS[\"raw\"], \"s\", \"Timer-XL raw\"),\n",
    "           \"time_moe\": (EXPERT_COLORS[\"time_moe\"], \"^\", \"Time-MoE 0-shot\"),\n",
    "           \"sundial\": (EXPERT_COLORS[\"sundial\"], \"v\", \"Sundial 0-shot\"),\n",
    "           \"Gate-old-expA\": (GREY_DARK, \"D\", \"old gate (exp A)\"),\n",
    "           \"Gate-NEW-alarm\": (IKB, \"*\", \"NEW gate (alarm)\")}\n",
    "    fig, ax = plt.subplots(figsize=(8.6, 6.3)); fig.patch.set_facecolor(PAPER); ax.set_facecolor(PAPER)\n",
    "    ax.axvspan(0.05, 0.17, color=\"#e34948\", alpha=0.07, zorder=0)\n",
    "    ax.axvline(0.05, color=\"#a03a2e\", lw=1.3, ls=(0, (6, 3)), zorder=2)\n",
    "    ax.text(0.0515, 0.175, \"5% FAR budget\", color=\"#a03a2e\", fontsize=9, rotation=90, va=\"bottom\", ha=\"left\")\n",
    "    ax.text(0.108, 0.655, \"over budget\\n(unusable)\", color=\"#a03a2e\", fontsize=9.5, ha=\"center\", style=\"italic\")\n",
    "    row = lambda m: d[d.model == m].iloc[0]\n",
    "    o, n = row(\"Gate-old-expA\"), row(\"Gate-NEW-alarm\")\n",
    "    ax.annotate(\"\", xy=(n.FAR, n.recall), xytext=(o.FAR, o.recall),\n",
    "                arrowprops=dict(arrowstyle=\"-|>\", color=IKB, lw=1.7, alpha=0.65, shrinkA=8, shrinkB=12))\n",
    "    ax.text((o.FAR + n.FAR) / 2 - 0.004, (o.recall + n.recall) / 2 - 0.03, \"dominates\",\n",
    "            color=IKB, fontsize=8, style=\"italic\", ha=\"center\")\n",
    "    for m, (c, mk, lab) in STY.items():\n",
    "        r = row(m); big = m == \"Gate-NEW-alarm\"\n",
    "        ax.scatter(r.FAR, r.recall, s=560 if big else 200, marker=mk, c=c,\n",
    "                   edgecolor=\"white\", linewidth=1.7 if big else 1.1, zorder=10 if big else 6)\n",
    "        xy = ((r.FAR + 0.006, r.recall + 0.028) if big else\n",
    "              (r.FAR - 0.006, r.recall + 0.028) if m == \"diff\" else (r.FAR + 0.006, r.recall + 0.006))\n",
    "        ax.annotate(f\"{lab}\\nrecall={r.recall:.2f}, FAR={r.FAR:.2f}\", (r.FAR, r.recall), xytext=xy,\n",
    "                    fontsize=9.0 if big else 8.2, color=c, fontweight=\"bold\" if big else \"normal\",\n",
    "                    va=\"center\", ha=\"right\" if m == \"diff\" else \"left\")\n",
    "    ax.set_xlabel(\"false-alarm rate  FAR   (lower is better  ←)\", fontsize=11, color=GREY_DARK)\n",
    "    ax.set_ylabel(\"recall   (higher is better  ↑)\", fontsize=11, color=GREY_DARK)\n",
    "    ax.set_xlim(-0.01, 0.17); ax.set_ylim(0.15, 0.70)\n",
    "    ax.grid(color=GREY_LIGHT, lw=0.6, alpha=0.5)\n",
    "    for s in ax.spines.values(): s.set_color(GREY_LIGHT)\n",
    "    ax.set_title(\"Recall vs false-alarm rate  ·  Run9-10 mag=25 clean windows\\n\"\n",
    "                 \"Within budget (left of line) the NEW gate has the highest recall; diff exceeds budget; old gate is dominated\",\n",
    "                 fontsize=10.2, color=INK, loc=\"left\", pad=10)\n",
    "    fig.tight_layout()\n",
    "    if save:\n",
    "        for ext in (\"png\", \"pdf\"): fig.savefig(HERE / f\"pareto_recall_far.{ext}\", dpi=300, facecolor=PAPER)\n",
    "        print(\"saved:\", HERE / \"pareto_recall_far.png\")\n",
    "    plt.show()\n",
    "    print(d[[\"model\", \"recall\", \"FAR\"]].round(3).to_string(index=False))\n",
    "    return fig\n",
    "\n",
    "plot_pareto();      # 存图:plot_pareto(save=True)"
   ]
  }
 ],
